# Resend API Key for contact form email functionality
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Optional: log each estimate submission to a Google Sheet (no API key needed – uses Apps Script web app)
# See GOOGLE_SHEET_WEBHOOK.md for setup. Leave unset to skip.
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
# GOOGLE_SHEETS_WEBHOOK_SECRET=your_secret_phrase

# --- efesop.com/pay storefront ---
# LIVE Stripe secret key (sk_live_...) for the /pay catalogue checkout.
STRIPE_PAY_SECRET_KEY=sk_live_your_live_secret_key_here
# Site origin used for Stripe success/cancel redirect URLs.
# Leave unset to fall back to the request origin (works for local + preview).
NEXT_PUBLIC_SITE_URL=https://efesop.com

# --- greg.efesop.com (G.E. Revamp Services Limited) ---
# A separate contractor site sharing this deployment. See docs/greg/setup.md.
# Stripe - the SEPARATE G.E. Revamp company account (never efesop's):
STRIPE_GREG_SECRET_KEY=sk_live_or_test_key_for_ge_revamp
STRIPE_GREG_WEBHOOK_SECRET=whsec_from_the_ge_revamp_webhook_endpoint
# PostHog - a separate project for greg.efesop.com:
NEXT_PUBLIC_POSTHOG_KEY_GREG=phc_greg_project_key
# Admin area (gates /admin, /admin/* and /create-invoice) - username is "greg":
GREG_ADMIN_PASSWORD=choose_a_strong_password
# Supabase (the George-OS project) - payments, editable content, render orders:
GREG_SUPABASE_URL=https://ygyeyprogpawmjzjyrew.supabase.co
GREG_SUPABASE_SERVICE_KEY=service_role_key_from_supabase
# AI Render Studio (/admin/render-studio):
ANTHROPIC_API_KEY=sk-ant-your_key
RUNWARE_API_KEY=your_runware_key
# Optional - where render-order emails go (default: George + efesop@hotmail.co.uk):
# GREG_RENDER_NOTIFY_EMAIL=you@example.com
# Optional - mirror captured customers into a Notion database:
# GREG_NOTION_TOKEN=secret_xxx
# GREG_NOTION_CUSTOMERS_DB_ID=xxxxxxxxxxxx

# --- efesop.com/admin (private time-tracking) ---
# Password gate for /admin and /admin/* (password-only, no username).
EFESOP_ADMIN_PASSWORD=
# Supabase (the george-os project) - the private `billing` schema via public RPCs.
GEORGE_OS_SUPABASE_URL=
GEORGE_OS_SUPABASE_SERVICE_KEY=

# Issuer / bank / identity frozen into every invoice at issue time (see lib/admin/issuer.ts).
# Not secret (prints on every invoice), but kept out of git. CLI uses secrets.json instead.
EFESOP_ISSUER_NAME=
EFESOP_ISSUER_ROLE=
EFESOP_ISSUER_LOCATION=
EFESOP_TIC_NUMBER=
EFESOP_SOCIAL_INSURANCE_NUMBER=
EFESOP_BANK_ACCOUNT_NAME=
EFESOP_BANK_IBAN=
EFESOP_BANK_BIC=
EFESOP_BANK_NAME=
